{
  "name": "subtrackt-site",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "npm run content && vite dev --port 3000",
    "build": "npm run content && vite build && node scripts/check-links.mjs",
    "preview": "vite preview",
    "test": "npm run content && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lonik/prestige": "latest",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "^1.162.4",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "^1.162.4",
    "@tanstack/router-plugin": "^1.132.0",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.16"
