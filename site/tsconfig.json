{
  "include": ["**/*.ts", "**/*.tsx", "**/*.mjs"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [
      "@lonik/prestige/client",
      "vite/client"
    ],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // `scripts/` is plain JavaScript -- it runs under node before Vite is involved, so it cannot be
    // TypeScript. `allowJs` is what lets the tests import it and still be typechecked.
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
